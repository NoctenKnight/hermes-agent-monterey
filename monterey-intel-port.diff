diff --git a/pm/update.py b/pm/update.py
index 86de317fee..f7f2dc9e60 100644
--- a/pm/update.py
+++ b/pm/update.py
@@ -366,6 +366,11 @@ def node_latest_versions() -> list[str]:
         if v.startswith("v"):
             v = v[1:]
         if re.fullmatch(r"\d+\.\d+\.\d+", v):
+            # LOCAL PATCH for macOS 12 Monterey: Node 22+ links a newer
+            # libc++ (__libcpp_verbose_abort) than Monterey ships, so the
+            # staged binary fails verification. Cap at the Node 20.x line.
+            if int(v.split(".")[0]) > 20:
+                continue
             out.append(v)
     return out
 
